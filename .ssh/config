# IdentitiesOnly: offer only the listed key, never other keys from the agent,
# so each alias always signs in to GitHub as the intended account.
Host github.com
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_personal
	IdentitiesOnly yes

Host github-benjaminblodgett311
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_school
	IdentitiesOnly yes

Host *
	SendEnv COLORTERM
