#!/usr/bin/env python3
from pathlib import Path
import datetime
import os
import re
import shutil

home = Path.home()
target = home / '.local/share/applications/firefox-esr.desktop'
source = target if target.exists() else Path('/usr/share/applications/firefox-esr.desktop')
if not source.exists():
    raise SystemExit(0)
old = source.read_text()
text = re.sub(r'^Exec=\S+', 'Exec="' + str(home / '.local/bin/firefox') + '"', old, flags=re.M)
if target.exists() and target.read_text() == text:
    raise SystemExit(0)
if target.exists() or target.is_symlink():
    backup = Path(os.environ.get('XDG_STATE_HOME', home / '.local/state')) / 'dotfiles/backups' / ('firefox-launcher-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S'))
    backup.mkdir(parents=True, mode=0o700)
    shutil.copy2(target, backup / target.name, follow_symlinks=False)
target.parent.mkdir(parents=True, exist_ok=True)
temporary = target.with_suffix('.desktop.dotfiles-new')
temporary.write_text(text)
temporary.replace(target)
