#!/usr/bin/env python3
"""Install public Griffo release assets, verified against apt's signed index."""
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

allowed = {'zig', 'ghostty', 'lazygit', 'yazi', 'eza', 'uv', 'bun', 'tigerbeetle', 'zoxide', 'neovim', 'fastfetch'}
package = sys.argv[1]
if package not in allowed:
    raise SystemExit('Unsupported release package: ' + package)

def fetch_json(url):
    request = urllib.request.Request(url, headers={'Accept': 'application/vnd.github+json'})
    with urllib.request.urlopen(request, timeout=60) as response:
        return json.load(response)

def metadata(name):
    text = subprocess.check_output(['apt-cache', 'show', '--no-all-versions', name], text=True)
    return dict(line.split(': ', 1) for line in text.splitlines() if ': ' in line and not line.startswith(' '))

with tempfile.TemporaryDirectory(prefix='dotfiles-release-') as tmp:
    # apt's _apt sandbox needs to traverse and read public package files.
    os.chmod(tmp, 0o755)
    files = []
    pending = [package]
    seen = set()
    while pending:
        name = pending.pop()
        if name in seen:
            continue
        seen.add(name)
        meta = metadata(name)
        checksum = meta['SHA256']
        filename = Path(meta['Filename']).name
        version = meta['Version']
        repository = f'https://api.github.com/repos/dariogriffo/{package}-debian/releases'
        # Older suite-specific releases use tags such as 1.1.3+5.
        match = re.match(r'(.+?)-(\d+)', version)
        release_urls = []
        if match:
            tag = match[1] + '+' + match[2]
            release_urls.append(repository + '/tags/' + urllib.parse.quote(tag, safe=''))
        release_urls.append(repository + '?per_page=10')
        asset = None
        for release_url in release_urls:
            try:
                result = fetch_json(release_url)
            except urllib.error.HTTPError as error:
                if error.code == 404:
                    continue
                raise
            candidates = result if isinstance(result, list) else [result]
            for release in candidates:
                for item in release['assets']:
                    if item.get('digest') == 'sha256:' + checksum or item['name'] == filename:
                        asset = item
                        break
                if asset:
                    break
            if asset:
                break
        if not asset:
            raise SystemExit(f'No public release asset matching signed apt metadata for {name} {version}')
        target = Path(tmp) / filename
        print(f'Downloading {name} {version}', flush=True)
        with urllib.request.urlopen(asset['browser_download_url'], timeout=120) as response, target.open('wb') as output:
            while chunk := response.read(1024 * 1024):
                output.write(chunk)
        if hashlib.sha256(target.read_bytes()).hexdigest() != checksum:
            raise SystemExit('Checksum mismatch: ' + name)
        target.chmod(0o644)
        files.append(str(target))
        # These packages use split release dependencies unavailable in Debian.
        for dependency in re.findall(r'(?:^|,)\s*([a-z0-9+.-]+)', meta.get('Depends', '')):
            if dependency in {'zig-stable', 'bun-one', 'bun-profile', 'neovim-runtime'}:
                pending.append(dependency)
    subprocess.run(['sudo', 'DEBIAN_FRONTEND=noninteractive', 'apt-get', '-qq', '-y',
                    '--no-remove', '-o', 'DPkg::Lock::Timeout=300', 'install', *files], check=True)
