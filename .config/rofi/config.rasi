configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "";
    display-run: "";
    drun-display-format: "{name}";
    font: "JetBrains Mono 12";
}

// The theme that matches the wallpaper, written by ~/.local/bin/wallpaper.
// (rofi uses its built-in theme until that has run once.)
@theme "~/.local/state/dotfiles/rofi.rasi"
