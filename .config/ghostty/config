# Ghostty config. All options: `ghostty +show-config --default --docs`
# or https://ghostty.org/docs/config

font-family = JetBrains Mono
font-size = 12
background-opacity = 0.8
window-padding-x = 8
window-padding-y = 8
window-decoration = false
confirm-close-surface = false
theme = ben256
bold-is-bright = false
gtk-custom-css = ~/.config/ghostty/style.css

# Every terminal window starts its own tmux session; exiting tmux closes the window.
command = tmux new-session

# Let Ctrl+Tab / Ctrl+Shift+Tab reach tmux and Neovim (buffer switching)
# instead of switching Ghostty tabs.
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
