# App launcher
super + {a, o}
	"$HOME/.local/bin/launcher" -show drun

# Super+?: edit this file in a new terminal; quitting Neovim closes it.
# Super+R then loads the changes. (? is Shift+/, which sxhkd needs spelled
# out.)
super + shift + slash
	ghostty -e "$HOME/.local/bin/tmux-session" nvim "$HOME/.config/sxhkd/sxhkdrc"

# Reload sxhkd
super + r
	pkill -USR1 -x sxhkd

# Close / kill window
super + {_,shift + }Escape
	bspc node -{c,k}

# Alternate between tiled and monocle layout: monocle shows just the focused
# window, filling the screen (no gaps, borders or bar), so Super+Return works
# like Alt+Enter on Windows. Unlike bspwm's fullscreen state, switching
# windows (Super+T/F) still brings the other window to the front.
super + {Tab,Return}
	bspc desktop -l next

# Swap current node with the biggest window
super + g
	bspc node -s biggest.window

# Super+S floats a window and Super+S again tiles it.
super + s
	bspc node -t ~floating

# Go to the terminal / Firefox, or open it if there isn't one. With Shift,
# always open a new one.
# (One binding each: sxhkd's {a,b} pairing across two groups is easy to get
# backwards.)
super + t
    python3 "$HOME/.config/sxhkd/scripts/focus-app" terminal
super + f
    python3 "$HOME/.config/sxhkd/scripts/focus-app" browser
super + shift + t
    python3 "$HOME/.config/sxhkd/scripts/focus-app" terminal new
super + shift + f
    python3 "$HOME/.config/sxhkd/scripts/focus-app" browser new

# Focus / move window in direction: m/n/e/i = left/down/up/right, the same
# keys as tmux panes and nvim windows
super + {_,shift + }{m,n,e,i}
	bspc node -{f,s} {west,south,north,east}

# Focus desktop
super + {1-9,0}
	bspc desktop -f '^{1-9,10}'

# Send window to desktop
super + shift + {1-9,0}
	bspc node -d '^{1-9,10}'

# Expand window
super + alt + {m,n,e,i}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Shrink window
super + alt + shift + {m,n,e,i}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# Preselect direction
super + ctrl + {m,n,e,i}
	bspc node -p {west,south,north,east}

# Cancel preselect
super + ctrl + space
	bspc node -p cancel

# Quit / restart bspwm (bspwmrc is safe to rerun)
super + alt + {q,r}
	bspc {quit,wm -r}

# Cycle windows on the current desktop; Shift reverses direction.
super + {_,shift + }c
    bspc node -f {next,prev}.local.!hidden.window

# Return to the previous window.
super + grave
    bspc node -f last

# Volume keys. Raising stops at 100%.
XF86AudioRaiseVolume
    wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
XF86AudioLowerVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
XF86AudioMicMute
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
