# Terminal
super + Return
	ghostty

# App launcher
super + @space
	rofi -show drun

# Reload sxhkd
super + Escape
	pkill -USR1 -x sxhkd

# Close / kill window
super + {_,shift + }w
	bspc node -{c,k}

# Alternate between tiled and monocle layout
super + Tab
	bspc desktop -l next

# Swap current node with the biggest window
super + g
	bspc node -s biggest.window

# Set window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Focus / move window in direction: m/n/e/i = left/down/up/right, the same
# keys as tmux panes and nvim windows
super + {_,shift + }{m,n,e,i}
	bspc node -{f,s} {west,south,north,east}

# Focus desktop
super + {1-9,0}
	bspc desktop -f '^{1-9,10}'

# Send window to desktop
super + shift + {1-9,0}
	bspc node -d '^{1-9,10}'

# Expand window
super + alt + {m,n,e,i}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Shrink window
super + alt + shift + {m,n,e,i}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# Preselect direction
super + ctrl + {m,n,e,i}
	bspc node -p {west,south,north,east}

# Cancel preselect
super + ctrl + space
	bspc node -p cancel

# Quit / restart bspwm (bspwmrc is safe to rerun)
super + alt + {q,r}
	bspc {quit,wm -r}
