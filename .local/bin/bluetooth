#!/bin/sh
# Bluetooth menu: rofi-bluetooth (installed by install.sh) in the current
# rofi theme.
command -v rofi-bluetooth >/dev/null ||
    exec "$HOME/.local/bin/launcher" -e "rofi-bluetooth is not installed. Run install.sh."
# shellcheck disable=SC2046  # one theme argument per line, no spaces
exec rofi-bluetooth $("$HOME/.local/bin/launcher" --args)
