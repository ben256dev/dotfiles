#!/bin/sh
# Wi-Fi menu: networkmanager-dmenu (installed by install.sh) in the current
# rofi theme. Its settings are in ~/.config/networkmanager-dmenu/config.ini.
command -v networkmanager_dmenu >/dev/null ||
    exec "$HOME/.local/bin/launcher" -e "networkmanager-dmenu is not installed. Run install.sh."
# shellcheck disable=SC2046  # one theme argument per line, no spaces
exec networkmanager_dmenu $("$HOME/.local/bin/launcher" --args)
