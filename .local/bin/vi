#!/usr/bin/env bash
# vi, but as you (not root) it won't open .env files, which hold secrets:
# sudo vi asks for your password first. (sudo looks vi up in its own PATH,
# without ~/.local/bin, so sudo vi is the real vi.) The same files as v
# refuses: .env, .env.*, *.env, but not templates like .env.example.
set -u

if [ "$(id -u)" != 0 ]; then
    refused=()
    for arg in "$@"; do
        case "$arg" in -* | +*) continue ;; esac
        case "$(basename -- "$arg")" in
            *.example | *.sample | *.template | *.dist) ;;
            .env | .env.* | *.env) refused+=("$arg") ;;
        esac
    done
    if [ "${#refused[@]}" -gt 0 ]; then
        printf "vi: won't open .env files as you, they hold secrets: %s\n" "${refused[*]}" >&2
        printf 'vi: edit with: sudo vi' >&2
        printf ' %q' "${refused[@]}" >&2
        printf '\n' >&2
        exit 1
    fi
fi

# The real vi: the next one on PATH that isn't this script.
self=$(readlink -f -- "$0")
while IFS= read -r candidate; do
    if [ "$(readlink -f -- "$candidate")" != "$self" ]; then
        exec "$candidate" "$@"
    fi
done < <(type -ap vi)
printf 'vi: no other vi on PATH\n' >&2
exit 127
