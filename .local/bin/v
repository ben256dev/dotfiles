#!/usr/bin/env bash
set -euo pipefail

query="${*:-}"

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  files="$(git ls-files --cached --others --exclude-standard)"
else
  if command -v fd >/dev/null 2>&1; then
    files="$(fd --type f)"
  elif command -v fdfind >/dev/null 2>&1; then
    files="$(fdfind --type f)"
  else
    printf 'v: requires fd (or fdfind) outside a git repo\n' >&2
    exit 1
  fi
fi

f="$(printf '%s\n' "$files" | fzf --query="$query" --select-1 --exit-0)" || exit 0
[ -n "$f" ] || exit 0

tmpdir="$(mktemp -d)"
trap 'rm -rf -- "$tmpdir"' EXIT

mkdir -p "$tmpdir/before/$(dirname "$f")"
mkdir -p "$tmpdir/after/$(dirname "$f")"

before="$tmpdir/before/$f"
after="$tmpdir/after/$f"

[ -f "$f" ] && cp -- "$f" "$before"
vim -c 'autocmd VimEnter * normal! g;' "$f"
[ -f "$f" ] && cp -- "$f" "$after"

if [ -f "$before" ] && [ -f "$after" ] && ! cmp -s "$before" "$after"; then
  (
    cd "$tmpdir" || exit
    git diff --no-index --color=always -U5 "before/$f" "after/$f" \
      | diff-so-fancy \
      | sed '1,3d; s|after/||g; s|before/||g'
  )
fi
