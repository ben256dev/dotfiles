#!/usr/bin/env bash
set -euo pipefail

query="${*:-}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/v"
last_file_path="$state_dir/last_file"
history_file_path="$state_dir/history"
diff_cache_dir="$state_dir/diffs"
diff_index_path="$diff_cache_dir/index.tsv"

abs_path() {
  local p="$1"
  if command -v realpath >/dev/null 2>&1; then
    realpath -- "$p"
  else
    printf '%s\n' "$PWD/$p"
  fi
}

record_open() {
  local full="$1"
  mkdir -p "$state_dir"
  printf '%s\n' "$full" > "$last_file_path"
  touch "$history_file_path"
  awk -v new="$full" 'BEGIN{print new} $0 != new {print $0}' "$history_file_path" > "${history_file_path}.tmp"
  mv "${history_file_path}.tmp" "$history_file_path"
}

cache_diff() {
  local file="$1"
  local diff_tmp="$2"
  local ts id safe ansi_path html_path full_file

  mkdir -p "$diff_cache_dir"
  ts="$(date +%Y-%m-%dT%H:%M:%S%z)"
  id="$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
  safe="$(basename "$file" | tr -cs 'A-Za-z0-9._-' '_')"
  ansi_path="$diff_cache_dir/${id}-${safe}.ansi"
  html_path="$diff_cache_dir/${id}-${safe}.html"
  full_file="$(abs_path "$file")"

  cp -- "$diff_tmp" "$ansi_path"

  if command -v aha >/dev/null 2>&1; then
    aha --black < "$ansi_path" > "$html_path" 2>/dev/null || true
  fi

  printf '%s\t%s\t%s\t%s\n' "$ts" "$full_file" "$ansi_path" "$html_path" >> "$diff_index_path"
}

output_cached_diffs() {
  local mode="${1:-ansi}"

  [ -f "$diff_index_path" ] || exit 0

  if [ "$mode" = "html" ]; then
    awk -F '\t' 'NF >= 4 && $4 != "" {print $4}' "$diff_index_path" | while IFS= read -r html; do
      [ -f "$html" ] || continue
      cat "$html"
      printf '\n'
    done
    exit 0
  fi

  awk -F '\t' 'NF >= 3 && $3 != "" {print $3}' "$diff_index_path" | while IFS= read -r ansi; do
    [ -f "$ansi" ] || continue
    cat "$ansi"
    printf '\n'
  done
  exit 0
}

render_diff() {
  local old_file="$1"
  local new_file="$2"

  if command -v diff-so-fancy >/dev/null 2>&1; then
    git diff --no-index --color=always -U5 "$old_file" "$new_file" \
      | diff-so-fancy \
      | sed '1,3d; s|after/||g; s|before/||g' || true
  else
    git diff --no-index --color=always -U5 "$old_file" "$new_file" || true
  fi
}

open_file() {
  local file="$1"
  local tmpdir before after diff_tmp

  tmpdir="$(mktemp -d)"

  mkdir -p "$tmpdir/before/$(dirname "$file")"
  mkdir -p "$tmpdir/after/$(dirname "$file")"

  before="$tmpdir/before/$file"
  after="$tmpdir/after/$file"

  [ -f "$file" ] && cp -- "$file" "$before"
  nvim -c 'autocmd VimEnter * normal! g;' "$file"
  [ -f "$file" ] && cp -- "$file" "$after"

  if [ -f "$before" ] && [ -f "$after" ] && ! cmp -s "$before" "$after"; then
    diff_tmp="$(mktemp)"
    (
      cd "$tmpdir" || exit
      render_diff "before/$file" "after/$file" | tee "$diff_tmp"
    )
    cache_diff "$file" "$diff_tmp"
    rm -f -- "$diff_tmp"
  fi

  rm -rf -- "$tmpdir"
}

create_file() {
  local file="$1"
  local parent

  if [ -z "$file" ]; then
    printf 'v: file path cannot be empty\n' >&2
    exit 1
  fi

  if [ -d "$file" ]; then
    printf 'v: path is a directory: %s\n' "$file" >&2
    exit 1
  fi

  if [ -L "$file" ] && [ ! -e "$file" ]; then
    printf 'v: path is a broken symlink: %s\n' "$file" >&2
    exit 1
  fi

  if [ -e "$file" ] && [ ! -f "$file" ]; then
    printf 'v: path is not a regular file: %s\n' "$file" >&2
    exit 1
  fi

  parent="$(dirname -- "$file")"
  if [ ! -d "$parent" ]; then
    printf 'v: parent directory does not exist: %s\n' "$parent" >&2
    exit 1
  fi

  if [ ! -e "$file" ]; then
    touch -- "$file"
  fi

  record_open "$(abs_path "$file")"
  open_file "$file"
}

if [ "${1:-}" = "-c" ] || [ "${1:-}" = "--create" ]; then
  if [ "$#" -ne 2 ]; then
    printf 'usage: v -c FILE\n' >&2
    exit 1
  fi
  create_file "$2"
  exit 0
fi

if [ "${1:-}" = "+" ] || [ "${1:-}" = "diffs" ]; then
  if [ "${2:-}" = "html" ] || [ "${1:-}" = "html" ]; then
    output_cached_diffs "html"
  fi
  output_cached_diffs "ansi"
fi

if [ "${1:-}" = "-" ] && [ "$#" -eq 1 ]; then
  if [ ! -f "$last_file_path" ]; then
    printf 'v: no previous file recorded\n' >&2
    exit 1
  fi
  f="$(cat "$last_file_path")"
  if [ -z "$f" ] || [ ! -e "$f" ]; then
    printf 'v: previous file is missing: %s\n' "$f" >&2
    exit 1
  fi
  record_open "$(abs_path "$f")"
  open_file "$f"
  exit 0
fi

if [ "${1:-}" = "~" ] || [ "${1:-}" = "$HOME" ]; then
  history_query="${*:2}"
  if [ ! -f "$history_file_path" ]; then
    printf 'v: no file history recorded\n' >&2
    exit 1
  fi
  f="$(
    awk 'NF && system("[ -e \"" $0 "\" ]") == 0 {print}' "$history_file_path" \
      | fzf --query="$history_query" --select-1 --exit-0
  )" || exit 0
  [ -n "$f" ] || exit 0
  record_open "$(abs_path "$f")"
  open_file "$f"
  exit 0
fi

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  files="$(git ls-files --cached --others --exclude-standard)"
else
  if command -v fd >/dev/null 2>&1; then
    files="$(fd --type f)"
  elif command -v fdfind >/dev/null 2>&1; then
    files="$(fdfind --type f)"
  else
    printf 'v: requires fd (or fdfind) outside a git repo\n' >&2
    exit 1
  fi
fi

if f="$(printf '%s\n' "$files" | fzf --query="$query" --select-1 --exit-0)"; then
  if [ -z "$f" ]; then
    if [ -n "$query" ]; then
      printf 'v: no matching file for: %s\n' "$query" >&2
      printf 'v: create it with: v -c %q\n' "$query" >&2
      exit 1
    fi
    exit 0
  fi
else
  fzf_status=$?
  if [ "$fzf_status" -eq 1 ] && [ -n "$query" ]; then
    printf 'v: no matching file for: %s\n' "$query" >&2
    printf 'v: create it with: v -c %q\n' "$query" >&2
    exit 1
  fi
  exit 0
fi

record_open "$(abs_path "$f")"
open_file "$f"
