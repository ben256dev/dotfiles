#!/usr/bin/env bash
set -euo pipefail

resume_line=""
# The file to start on (v reopening the last session: the one you left).
resume_current=""
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/v"
last_file_path="$state_dir/last_file"
last_current_path="$state_dir/last_current"
missing_file_path="$state_dir/missing_file"
missing_directory_path="$state_dir/missing_directory"
history_file_path="$state_dir/history"
diff_cache_dir="$state_dir/diffs"
diff_index_path="$diff_cache_dir/index.tsv"
diff_cache_keep=200

# Temporary directories: the file snapshots (open_files) and the pinned
# lines (v !). Removed however v exits.
snapshot_dir=""
pin_dir=""
cleanup() {
  [ -z "$snapshot_dir" ] || rm -rf -- "$snapshot_dir"
  [ -z "$pin_dir" ] || rm -rf -- "$pin_dir"
}
trap cleanup EXIT

# v ! (or -v): select lines from the terminal with tmux's copy mode, to pin
# them in a split above the file. The lines are captured from the pane with their
# colours (capture-pane -e); the selection only says which whole lines.
#
# tmux only reports the selection while copy mode is open, so this watches
# it until copy mode ends. y (or Enter) saves a copy buffer and pins the
# lines; leaving any other way (Escape, q) saves none and cancels.
select_pinned_lines() {
  local pane="${TMUX_PANE:-}" buffer_before state last="" in_mode
  local present start end history

  if [ -z "${TMUX:-}" ] || [ -z "$pane" ]; then
    printf 'v: -v selects lines with tmux copy mode, so it needs tmux\n' >&2
    exit 1
  fi

  buffer_before="$(tmux list-buffers -F '#{buffer_name}' 2>/dev/null | head -n 1)"
  tmux copy-mode -t "$pane"

  while :; do
    state="$(tmux display -p -t "$pane" \
      '#{pane_in_mode} #{selection_present} #{selection_start_y} #{selection_end_y} #{history_size}')"
    read -r in_mode present _ <<< "$state"
    [ "$in_mode" = 1 ] || break
    [ "$present" = 1 ] && last="$state"
    sleep 0.03
  done

  [ -n "$last" ] || return 1
  [ "$(tmux list-buffers -F '#{buffer_name}' 2>/dev/null | head -n 1)" != "$buffer_before" ] || return 1

  read -r _ _ start end history <<< "$last"
  if [ "$start" -gt "$end" ]; then
    local swap="$start"
    start="$end"
    end="$swap"
  fi

  pin_dir="$(mktemp -d)"
  # capture-pane counts the visible screen from 0 and the scrollback above
  # it in negatives. -J joins wrapped lines.
  tmux capture-pane -p -e -J -t "$pane" -S "$((start - history))" -E "$((end - history))" \
    > "$pin_dir/lines"

  # Neovim would draw the 16 basic ANSI colours (and plain text) in the
  # colour scheme's palette; give the pinned lines Ghostty's instead, so
  # they look as they did in the terminal. show-config leaves
  # out what matches Ghostty's defaults, so those fill the gaps. Without
  # Ghostty (over SSH, say) the pinned lines keep the colour scheme's.
  if command -v ghostty >/dev/null 2>&1; then
    { ghostty +show-config; ghostty +show-config --default; } 2>/dev/null | awk '
      /^palette = ([0-9]|1[0-5])=#/ { split($3, p, "="); key = p[1]; value = p[2] }
      /^foreground = #/ { key = "fg"; value = $3 }
      key != "" && !(key in seen) { seen[key]; print key, value }
      { key = "" }' > "$pin_dir/colors"
  fi

  # Neovim shows them in an editable scratch buffer, with the colour codes
  # turned into highlights (extmarks), which move with the text as you edit
  # it. (baleia.nvim does this too, but puts the colour a code's length too
  # far right whenever the code has bold, underline or the like in it.)
  cat > "$pin_dir/pin.lua" <<'EOF'
local lines = vim.fn.readfile(vim.env.V_PIN_DIR .. '/lines')
local height = math.max(1, math.min(#lines, math.floor(vim.o.lines / 2)))
local buf = vim.api.nvim_create_buf(false, true)
vim.bo[buf].bufhidden = 'wipe'
-- In a split above the file.
vim.cmd('topleft ' .. height .. 'split')
local win = vim.api.nvim_get_current_win()
vim.api.nvim_win_set_buf(win, buf)
for option, value in pairs({ number = false, relativenumber = false, signcolumn = 'no', winfixheight = true }) do
  vim.wo[win][option] = value
end

-- The 16 basic colours: the terminal's, if v found them, otherwise the
-- colour scheme's (g:terminal_color_N), otherwise xterm's. Plain text gets
-- the terminal's text colour.
local palette = {}
local ok, colors = pcall(vim.fn.readfile, vim.env.V_PIN_DIR .. '/colors')
local normal = {}
for _, line in ipairs(ok and colors or {}) do
  local key, value = line:match('^(%w+) (#%x+)$')
  if key == 'fg' then
    normal = { fg = value }
  elseif key then
    palette[tonumber(key)] = value
  end
end
local xterm16 = { [0] = '#000000', '#cd0000', '#00cd00', '#cdcd00', '#0000ee', '#cd00cd', '#00cdcd', '#e5e5e5',
  '#7f7f7f', '#ff0000', '#00ff00', '#ffff00', '#5c5cff', '#ff00ff', '#00ffff', '#ffffff' }
local function color(n)
  if n < 16 then
    return palette[n] or vim.g['terminal_color_' .. n] or xterm16[n]
  elseif n < 232 then -- the 6x6x6 cube
    local steps = { 0, 95, 135, 175, 215, 255 }
    n = n - 16
    return string.format('#%02x%02x%02x', steps[math.floor(n / 36) + 1], steps[math.floor(n / 6) % 6 + 1], steps[n % 6 + 1])
  end
  local grey = 8 + (n - 232) * 10
  return string.format('#%02x%02x%02x', grey, grey, grey)
end

-- Apply one SGR sequence's parameters ("1;32", "38;5;208", ...) to style.
local flags = { [1] = 'bold', [3] = 'italic', [4] = 'underline', [7] = 'reverse', [9] = 'strikethrough' }
local unflags = { [22] = 'bold', [23] = 'italic', [24] = 'underline', [27] = 'reverse', [29] = 'strikethrough' }
local function apply(style, params)
  local codes = {}
  for code in ((params == '' and '0' or params) .. ';'):gmatch('([^;:]*)[;:]') do
    table.insert(codes, tonumber(code) or 0)
  end
  local i = 1
  while i <= #codes do
    local c = codes[i]
    if c == 0 then
      for key in pairs(style) do style[key] = nil end
    elseif flags[c] then
      style[flags[c]] = true
    elseif unflags[c] then
      style[unflags[c]] = nil
    elseif c >= 30 and c <= 37 then style.fg = color(c - 30)
    elseif c >= 90 and c <= 97 then style.fg = color(c - 90 + 8)
    elseif c >= 40 and c <= 47 then style.bg = color(c - 40)
    elseif c >= 100 and c <= 107 then style.bg = color(c - 100 + 8)
    elseif c == 39 then style.fg = nil
    elseif c == 49 then style.bg = nil
    elseif c == 38 or c == 48 then
      local key = c == 38 and 'fg' or 'bg'
      if codes[i + 1] == 5 and codes[i + 2] then
        style[key] = color(codes[i + 2])
        i = i + 2
      elseif codes[i + 1] == 2 and codes[i + 4] then
        style[key] = string.format('#%02x%02x%02x', codes[i + 2], codes[i + 3], codes[i + 4])
        i = i + 4
      end
    end
    i = i + 1
  end
end

-- Split each line into its text and the styled stretches of it. Any other
-- escape sequence (an OSC 8 link, say) is dropped.
local text, spans, style = {}, {}, {}
for row, raw in ipairs(lines) do
  local parts, col, pos = {}, 0, 1
  while pos <= #raw do
    local s, e, params = raw:find('\27%[([%d;:]*)m', pos)
    local chunk = raw:sub(pos, s and s - 1 or -1)
      :gsub('\27%].-\27\\', ''):gsub('\27%].-\7', ''):gsub('\27%[[%d;?]*%a', '')
    if #chunk > 0 then
      table.insert(parts, chunk)
      if next(style) then
        table.insert(spans, { row - 1, col, col + #chunk, vim.deepcopy(style) })
      end
      col = col + #chunk
    end
    if not s then break end
    apply(style, params)
    pos = e + 1
  end
  text[row] = table.concat(parts)
end

-- Without undo while the lines go in, so u can't empty the buffer.
vim.bo[buf].undolevels = -1
vim.api.nvim_buf_set_lines(buf, 0, -1, false, text)
vim.bo[buf].undolevels = vim.go.undolevels
vim.bo[buf].modified = false
pcall(vim.api.nvim_buf_set_name, buf, 'pinned')

-- One highlight group per style; set again after a colour scheme change,
-- which clears them.
local ns = vim.api.nvim_create_namespace('v_pinned')
local groups = {}
local function define()
  vim.api.nvim_set_hl(0, 'VPinnedNormal', normal)
  for name, definition in pairs(groups) do
    vim.api.nvim_set_hl(0, name, definition)
  end
end
for _, span in ipairs(spans) do
  local definition = span[4]
  local name = 'VPinned_' .. vim.fn.sha256(vim.inspect(definition)):sub(1, 12)
  groups[name] = definition
  vim.api.nvim_buf_set_extmark(buf, ns, span[1], span[2], { end_col = span[3], hl_group = name })
end
define()
vim.wo[win].winhighlight = 'Normal:VPinnedNormal'
vim.api.nvim_create_autocmd('ColorScheme', { callback = define })
-- Quitting the last file window would leave just the pinned lines open;
-- close them first so :q and :wq still quit.
vim.api.nvim_create_autocmd('QuitPre', {
  callback = function()
    local wins = vim.api.nvim_tabpage_list_wins(0)
    if #wins == 2 and vim.api.nvim_get_current_win() ~= win and vim.api.nvim_win_is_valid(win) then
      vim.api.nvim_win_close(win, true)
    end
  end,
})
vim.cmd('wincmd p')
EOF
}

abs_path() {
  realpath -m -- "$1"
}

report_missing_file() {
  local file="$1"

  mkdir -p "$state_dir"
  abs_path "$file" > "$missing_file_path"
  pwd -P > "$missing_directory_path"
  printf 'v: no matching file for: %s\n' "$file" >&2
  printf 'v: create it with: v -c\n' >&2
}

print_fuzzy_resolution_if_new() {
  local selected="$1"
  local selected_full

  selected_full="$(abs_path "$selected")"
  if [ ! -f "$last_file_path" ] || ! grep -Fqx -- "$selected_full" "$last_file_path"; then
    printf '%s\n' "$selected"
  fi
}

record_open() {
  local full="$1"
  mkdir -p "$state_dir"
  touch "$history_file_path"
  awk -v new="$full" 'BEGIN{print new} $0 != new {print $0}' "$history_file_path" > "${history_file_path}.tmp"
  mv "${history_file_path}.tmp" "$history_file_path"
}

# .env files hold secrets: v won't open them, since copies would stay in
# its diffs (~/.local/state/v/diffs) and Neovim's swap, undo and shada
# files. sudo vi asks for your password, then edits in plain vi. Templates
# (.env.example and the like) are fine.
refuse_env_files() {
  local file refused=()
  for file in "$@"; do
    case "$(basename -- "$file")" in
      *.example | *.sample | *.template | *.dist) ;;
      .env | .env.* | *.env) refused+=("$file") ;;
    esac
  done
  [ "${#refused[@]}" -gt 0 ] || return 0
  printf "v: won't open .env files, which hold secrets: %s\n" "${refused[*]}" >&2
  printf 'v: edit with: sudo vi' >&2
  printf ' %q' "${refused[@]}" >&2
  printf '\n' >&2
  exit 1
}

remember_session() {
  local file full
  local full_files=()

  refuse_env_files "$@"

  for file in "$@"; do
    full="$(abs_path "$file")"
    record_open "$full"
    full_files+=("$full")
  done

  printf '%s\n' "${full_files[@]}" > "$last_file_path"
  rm -f -- "$last_current_path"
}

# Like .env files to refuse_env_files, so a session never holds one.
is_env_file() {
  case "$(basename -- "$1")" in
    *.example | *.sample | *.template | *.dist) return 1 ;;
    .env | .env.* | *.env) return 0 ;;
  esac
  return 1
}

# What Neovim left open when it quit (open_files): the file you were on,
# then every file buffer. That's the last session now, and they all go
# into the history, the file you were on newest.
save_session() {
  local session="$1" current f full_files=()
  [ -s "$session" ] || return 0
  { IFS= read -r current; mapfile -t opened; } < "$session"
  for f in "${opened[@]}"; do
    if [ -n "$f" ] && ! is_env_file "$f"; then
      full_files+=("$(abs_path "$f")")
    fi
  done
  [ "${#full_files[@]}" -gt 0 ] || return 0
  for f in "${full_files[@]}"; do
    if [ "$f" != "$current" ]; then
      record_open "$f"
    fi
  done
  printf '%s\n' "${full_files[@]}" > "$last_file_path"
  if [ -n "$current" ] && ! is_env_file "$current"; then
    record_open "$(abs_path "$current")"
    abs_path "$current" > "$last_current_path"
  fi
}

cache_diff() {
  local file="$1"
  local diff_tmp="$2"
  local ts id safe ansi_path html_path

  mkdir -p "$diff_cache_dir"
  ts="$(date +%Y-%m-%dT%H:%M:%S%z)"
  id="$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
  safe="$(basename -- "$file" | tr -cs 'A-Za-z0-9._-' '_')"
  ansi_path="$diff_cache_dir/${id}-${safe}.ansi"
  html_path="$diff_cache_dir/${id}-${safe}.html"

  cp -- "$diff_tmp" "$ansi_path"

  if command -v aha >/dev/null 2>&1; then
    aha --black < "$ansi_path" > "$html_path" 2>/dev/null || true
  fi

  printf '%s\t%s\t%s\t%s\n' "$ts" "$(abs_path "$file")" "$ansi_path" "$html_path" >> "$diff_index_path"
  prune_diff_cache
}

# Keep only the newest $diff_cache_keep diffs.
prune_diff_cache() {
  local total ansi html

  total="$(wc -l < "$diff_index_path")"
  [ "$total" -gt "$diff_cache_keep" ] || return 0

  head -n "$((total - diff_cache_keep))" "$diff_index_path" \
    | while IFS=$'\t' read -r _ _ ansi html; do
        rm -f -- ${ansi:+"$ansi"} ${html:+"$html"}
      done
  tail -n "$diff_cache_keep" "$diff_index_path" > "${diff_index_path}.tmp"
  mv -- "${diff_index_path}.tmp" "$diff_index_path"
}

output_cached_diffs() {
  local column=3 path

  if [ "${1:-}" = "html" ]; then
    column=4
  fi
  [ -f "$diff_index_path" ] || exit 0

  awk -F '\t' -v c="$column" '$c != "" {print $c}' "$diff_index_path" | while IFS= read -r path; do
    [ -f "$path" ] || continue
    cat -- "$path"
    printf '\n'
  done
  exit 0
}

# Print a colored diff of a file's contents before and after editing.
render_diff() {
  local label="$1"
  local before="$2"
  local after="$3"
  local diff_cmd=(diff -U5 --color=always --palette='ln=1;38;5;13'
    --label "$label" --label "$label" -- "$before" "$after")

  if command -v diff-so-fancy >/dev/null 2>&1; then
    # Drop diff-so-fancy's three-line file header; the hunk header names the file.
    { "${diff_cmd[@]}" || true; } | diff-so-fancy | sed '1,3d' || true
  else
    "${diff_cmd[@]}" || true
  fi
}

open_files() {
  local files=("$@")
  local i diff_tmp

  # Snapshot each file so we can show what changed once nvim exits.
  # Global (not local) so the EXIT trap (cleanup) can still see it.
  snapshot_dir="$(mktemp -d)"

  for i in "${!files[@]}"; do
    if [ -f "${files[$i]}" ]; then
      cp -- "${files[$i]}" "$snapshot_dir/$i"
    fi
  done

  # v !: open the pinned lines above the file (select_pinned_lines).
  local pin_args=()
  if [ -n "$pin_dir" ]; then
    pin_args=(-c "luafile $pin_dir/pin.lua")
  fi

  # Neovim starts on $V_CURRENT if it's one of the files, then goes to line
  # $V_LINE, or the last change. When it quits, it writes the file you were
  # on and every file buffer still open (those opened with :e too) to
  # $V_SESSION_OUT: the session v reopens next time.
  cat > "$snapshot_dir/session.lua" <<'EOF'
local function real(name)
  return name ~= '' and vim.uv.fs_realpath(name) or nil
end
local function is_file(buf)
  return vim.bo[buf].buflisted and vim.bo[buf].buftype == '' and real(vim.api.nvim_buf_get_name(buf))
end

vim.api.nvim_create_autocmd('VimEnter', {
  once = true,
  -- So the file's own autocommands (filetype, highlighting) run when
  -- switching to it loads it.
  nested = true,
  callback = function()
    local current = vim.env.V_CURRENT
    if current and current ~= '' then
      for _, buf in ipairs(vim.api.nvim_list_bufs()) do
        if is_file(buf) == current then
          vim.api.nvim_set_current_buf(buf)
          break
        end
      end
    end
    local line = tonumber(vim.env.V_LINE or '')
    if line then
      vim.cmd('normal! ' .. line .. 'Gzz')
    else
      -- silent!: g; fails with E664 on files that have no change history yet.
      vim.cmd('silent! normal! g;zz')
    end
  end,
})

vim.api.nvim_create_autocmd('VimLeavePre', {
  once = true,
  callback = function()
    -- The file you were on: this window's, or (from the pinned lines, say)
    -- another window's in this tab.
    local current
    local wins = vim.api.nvim_tabpage_list_wins(0)
    table.insert(wins, 1, vim.api.nvim_get_current_win())
    for _, win in ipairs(wins) do
      current = is_file(vim.api.nvim_win_get_buf(win))
      if current then break end
    end
    local files = {}
    for _, buf in ipairs(vim.api.nvim_list_bufs()) do
      local file = is_file(buf)
      if file then table.insert(files, file) end
    end
    if #files > 0 then
      vim.fn.writefile({ current or '', unpack(files) }, vim.env.V_SESSION_OUT)
    end
  end,
})
EOF

  V_PIN_DIR="$pin_dir" V_CURRENT="$resume_current" V_LINE="$resume_line" \
    V_SESSION_OUT="$snapshot_dir/session" \
    nvim -c "luafile $snapshot_dir/session.lua" "${pin_args[@]}" -- "${files[@]}" || true
  save_session "$snapshot_dir/session"

  for i in "${!files[@]}"; do
    if [ -f "$snapshot_dir/$i" ] && [ -f "${files[$i]}" ] && ! cmp -s -- "$snapshot_dir/$i" "${files[$i]}"; then
      diff_tmp="$snapshot_dir/$i.diff"
      render_diff "${files[$i]}" "$snapshot_dir/$i" "${files[$i]}" | tee -- "$diff_tmp"
      cache_diff "${files[$i]}" "$diff_tmp"
    fi
  done
}

create_file() {
  local file="$1"
  local parent

  if [ -z "$file" ]; then
    printf 'v: file path cannot be empty\n' >&2
    exit 1
  fi

  if [ -d "$file" ]; then
    printf 'v: path is a directory: %s\n' "$file" >&2
    exit 1
  fi

  if [ -L "$file" ] && [ ! -e "$file" ]; then
    printf 'v: path is a broken symlink: %s\n' "$file" >&2
    exit 1
  fi

  if [ -e "$file" ] && [ ! -f "$file" ]; then
    printf 'v: path is not a regular file: %s\n' "$file" >&2
    exit 1
  fi

  refuse_env_files "$file"

  parent="$(dirname -- "$file")"
  if [ ! -d "$parent" ]; then
    printf 'v: parent directory does not exist: %s\n' "$parent" >&2
    exit 1
  fi

  if [ ! -e "$file" ]; then
    touch -- "$file"
  fi

  remember_session "$file"
  open_files "$file"
}

# Fuzzy-pick from $files, preferring exact basename matches, then files with
# the query's extension. Extra arguments are passed through to fzf.
fuzzy_pick() {
  local query="$1"
  local candidates="$files"
  local matches
  shift

  matches="$(printf '%s\n' "$files" | name="$query" awk -F/ '$NF == ENVIRON["name"]')"
  if [ -z "$matches" ] && [[ "$query" == *.* ]]; then
    matches="$(printf '%s\n' "$files" | suffix=".${query##*.}" awk '
      { s = ENVIRON["suffix"] }
      substr($0, length($0) - length(s) + 1) == s')"
  fi
  if [ -n "$matches" ]; then
    candidates="$matches"
  fi

  printf '%s\n' "$candidates" | fzf "$@" --query="$query" --select-1 --exit-0
}

usage() {
  cat <<'EOF'
usage: v [FILE | QUERY]...

  v                 reopen the last session, on the file you left it on
                    (with none, pick as v . does)
  v N | v -N        reopen the last session at line N
  v QUERY           open QUERY if it is a file, else fuzzy-match it
                    (exact file names win, then files with the same extension)
  v A B ...         open several files or queries at once
  v .               fuzzy-pick one or more files (git files, or fd outside git)
  v . QUERY...      the same as v QUERY, but every word is a file or query,
                    numbers too (v . 42 looks for 42); v .. looks for a dot
  v N ARGS          open what ARGS opens at line N (v 12 main.c)
  v -               reopen the last session (only that, never a pick)
  v ~ [QUERY]       pick from files you opened before
  v -c [FILE]       create FILE (or the last unmatched QUERY) and open it
  v !               in tmux, select lines of the terminal (y pins them) and
                    reopen the last session below them, in colour and
                    editable (v -v is v !)
  v ! ARGS          the same, but above what ARGS opens (v ! QUERY,
                    v !42, v ! ., v ! ~, ...)
  v + | v diffs     print the cached diffs of your edits (add "html" for HTML)
  v -h | v --help   show this help

!, ~, - and N go together in any order, run together or not: v !~ (pin,
then pick from history), v 12!~ or v ~!-12 (the same, at line 12), v !42
(pin above the last session, at line 42). Not two of -, ~ and .: they
open different things.

After nvim exits, v prints a diff of what you changed. The newest 200 diffs
are kept in ~/.local/state/v/diffs. So v won't open .env files (.env,
.env.*, *.env, but not .env.example and the like): use sudo vi.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

# The first arguments say how to open: ! pins terminal lines (also -v,
# --visual), ~ picks from history, - reopens the last session, . picks
# from all the files, and N (or -N) goes to line N. With none of them, v
# reopens the last session. !, ~, - and N go in any order, alone or run
# together: v !~, v !42, v ~!-12, v ! ~. -, ~ and . all say what to open,
# so only one of them.
pin=false
source="" # last (-), history (~) or pick (.)
source_name() {
  case "$1" in
    last) printf -- '- (the last session)' ;;
    history) printf -- '~ (history)' ;;
    pick) printf -- '. (all files)' ;;
  esac
}
set_source() {
  if [ -n "$source" ] && [ "$source" != "$1" ]; then
    printf 'v: %s and %s open different things; use one\n' "$(source_name "$source")" "$(source_name "$1")" >&2
    exit 1
  fi
  source="$1"
}
set_line() {
  if [ -n "$resume_line" ] && [ "$((10#$resume_line))" != "$((10#$1))" ]; then
    printf 'v: two line numbers: %s and %s\n' "$resume_line" "$1" >&2
    exit 1
  fi
  resume_line="$1"
}
while [ "$#" -gt 0 ]; do
  arg="$1"
  case "$arg" in
    -v | --visual) pin=true; shift; continue ;;
    # . : the rest are files and queries, numbers too (v . 42 looks for 42).
    # v .. is v . . (look for a dot).
    .) set_source pick; shift; break ;;
    ..) set_source pick; set -- . "${@:2}"; break ;;
    # Bash's tilde expansion: a lone ~ comes as $HOME, and ~- as $OLDPWD.
    "$HOME") arg='~' ;;
    "${OLDPWD:-}") [ -z "${OLDPWD:-}" ] || arg='~-' ;;
  esac
  # Only !, ~, - and digits, checked before any of it is taken. v 42 is
  # line 42 (of the last session), even with a file named 42: v . 42 or
  # v ./42 opens that. v !QUERY is v ! QUERY: the ! pins, and the rest is
  # looked at again.
  if ! [[ "$arg" =~ ^(-?[0-9]+|[-!~])+$ ]]; then
    [[ "$arg" == '!'?* ]] || break
    pin=true
    set -- "${arg#!}" "${@:2}"
    continue
  fi
  rest="$arg"
  while [ -n "$rest" ]; do
    if [[ "$rest" =~ ^-?([0-9]+)(.*)$ ]]; then
      set_line "${BASH_REMATCH[1]}"
      rest="${BASH_REMATCH[2]}"
      continue
    fi
    case "${rest:0:1}" in
      '!') pin=true ;;
      '~') set_source history ;;
      '-') set_source last ;;
    esac
    rest="${rest:1}"
  done
  shift
done
if [ -n "$resume_line" ]; then
  resume_line="$((10#$resume_line))"
  if [ "$resume_line" -eq 0 ]; then
    printf 'v: line number must be positive\n' >&2
    exit 1
  fi
fi
if [ "$source" = last ] && [ "$#" -gt 0 ]; then
  printf 'v: - reopens the last session, so it takes no files (got: %s)\n' "$*" >&2
  exit 1
fi

# Nothing to say what: the last session, or with none (or its files gone),
# all the files, as v . would.
if [ -z "$source" ] && [ "$#" -eq 0 ]; then
  source=pick
  if [ -f "$last_file_path" ] && [ -n "$(awk 'NF' "$last_file_path")" ]; then
    source=last
    while IFS= read -r f; do
      [ -z "$f" ] || [ -e "$f" ] || { source=pick; break; }
    done < "$last_file_path"
  fi
fi

if [ "$pin" = true ]; then
  # Run from .bashrc's Enter, the command line's newline waits until the
  # lines are picked (V_NEWLINE): copy mode opens with nothing scrolled.
  pinned=0
  select_pinned_lines || pinned=$?
  [ -z "${V_NEWLINE:-}" ] || printf '\n'
  [ "$pinned" = 0 ] || exit 0
fi

# (After v ., -c and + are queries like any other.)
if [ -z "$source" ] && { [ "${1:-}" = "-c" ] || [ "${1:-}" = "--create" ]; }; then
  if [ "$#" -eq 1 ]; then
    if [ ! -s "$missing_file_path" ] || [ ! -s "$missing_directory_path" ]; then
      printf 'usage: v -c [FILE]\n' >&2
      exit 1
    fi
    if [ "$(pwd -P)" != "$(cat -- "$missing_directory_path")" ]; then
      printf 'v: missing file was requested in another directory; use v -c FILE\n' >&2
      exit 1
    fi
    missing_file="$(cat -- "$missing_file_path")"
    if [ -e "$missing_file" ] || [ -L "$missing_file" ]; then
      printf 'usage: v -c [FILE]\n' >&2
      exit 1
    fi
    create_file "$missing_file"
    rm -f -- "$missing_file_path" "$missing_directory_path"
  elif [ "$#" -eq 2 ]; then
    create_file "$2"
  else
    printf 'usage: v -c [FILE]\n' >&2
    exit 1
  fi
  exit 0
fi

if [ -z "$source" ] && { [ "${1:-}" = "+" ] || [ "${1:-}" = "diffs" ]; }; then
  output_cached_diffs "${2:-}"
fi

if [ "$source" = last ]; then
  if [ ! -f "$last_file_path" ]; then
    printf 'v: no previous file recorded\n' >&2
    exit 1
  fi
  mapfile -t previous_files < <(awk 'NF' "$last_file_path")
  if [ "${#previous_files[@]}" -eq 0 ]; then
    printf 'v: no previous file recorded\n' >&2
    exit 1
  fi
  for f in "${previous_files[@]}"; do
    if [ ! -e "$f" ]; then
      printf 'v: previous file is missing: %s\n' "$f" >&2
      exit 1
    fi
  done
  [ ! -s "$last_current_path" ] || resume_current="$(cat -- "$last_current_path")"
  remember_session "${previous_files[@]}"
  open_files "${previous_files[@]}"
  exit 0
fi

if [ "$source" = history ]; then
  history_query="$*"
  if [ ! -f "$history_file_path" ]; then
    printf 'v: no file history recorded\n' >&2
    exit 1
  fi
  f="$(
    while IFS= read -r entry; do
      if [ -n "$entry" ] && [ -e "$entry" ]; then
        printf '%s\n' "$entry"
      fi
    done < "$history_file_path" | fzf --query="$history_query" --select-1 --exit-0
  )" || exit 0
  [ -n "$f" ] || exit 0
  remember_session "$f"
  open_files "$f"
  exit 0
fi

# Everything else (v . and v QUERY): each argument is an existing file or a
# fuzzy query, and with none, pick from all the files.
need_file_list=false
if [ "$#" -eq 0 ]; then
  need_file_list=true
fi
for arg in "$@"; do
  [ -f "$arg" ] || need_file_list=true
done

files=""
if [ "$need_file_list" = true ]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    files="$(git ls-files --cached --others --exclude-standard)"
  elif command -v fd >/dev/null 2>&1; then
    files="$(fd --type f)"
  elif command -v fdfind >/dev/null 2>&1; then
    files="$(fdfind --type f)"
  else
    printf 'v: requires fd (or fdfind) outside a git repo\n' >&2
    exit 1
  fi
fi

selected_files=()
fuzzy_selected_files=()

if [ "$#" -eq 0 ]; then
  selection="$(printf '%s\n' "$files" | fzf --multi --select-1 --exit-0)" || exit 0
  [ -n "$selection" ] || exit 0
  mapfile -t selected_files <<< "$selection"
else
  # A single query may pick several files; with several queries, one each.
  fzf_opts=()
  if [ "$#" -eq 1 ]; then
    fzf_opts=(--multi)
  fi

  for arg in "$@"; do
    if [ -f "$arg" ]; then
      selected_files+=("$arg")
      continue
    fi

    rc=0
    selection="$(fuzzy_pick "$arg" "${fzf_opts[@]}")" || rc=$?
    if [ "$rc" -eq 1 ] || { [ "$rc" -eq 0 ] && [ -z "$selection" ]; }; then
      report_missing_file "$arg"
      exit 1
    elif [ "$rc" -ne 0 ]; then
      exit 0 # fzf was cancelled
    fi

    mapfile -t picked <<< "$selection"
    selected_files+=("${picked[@]}")
    fuzzy_selected_files+=("${picked[@]}")
  done
fi

for f in "${fuzzy_selected_files[@]}"; do
  print_fuzzy_resolution_if_new "$f"
done
remember_session "${selected_files[@]}"
open_files "${selected_files[@]}"
