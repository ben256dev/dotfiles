#!/usr/bin/env bash
set -euo pipefail

resume_line=""
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/v"
last_file_path="$state_dir/last_file"
missing_file_path="$state_dir/missing_file"
missing_directory_path="$state_dir/missing_directory"
history_file_path="$state_dir/history"
diff_cache_dir="$state_dir/diffs"
diff_index_path="$diff_cache_dir/index.tsv"
diff_cache_keep=200

abs_path() {
  realpath -m -- "$1"
}

report_missing_file() {
  local file="$1"

  mkdir -p "$state_dir"
  abs_path "$file" > "$missing_file_path"
  pwd -P > "$missing_directory_path"
  printf 'v: no matching file for: %s\n' "$file" >&2
  printf 'v: create it with: v -c\n' >&2
}

print_fuzzy_resolution_if_new() {
  local selected="$1"
  local selected_full

  selected_full="$(abs_path "$selected")"
  if [ ! -f "$last_file_path" ] || ! grep -Fqx -- "$selected_full" "$last_file_path"; then
    printf '%s\n' "$selected"
  fi
}

record_open() {
  local full="$1"
  mkdir -p "$state_dir"
  touch "$history_file_path"
  awk -v new="$full" 'BEGIN{print new} $0 != new {print $0}' "$history_file_path" > "${history_file_path}.tmp"
  mv "${history_file_path}.tmp" "$history_file_path"
}

remember_session() {
  local file full
  local full_files=()

  for file in "$@"; do
    full="$(abs_path "$file")"
    record_open "$full"
    full_files+=("$full")
  done

  printf '%s\n' "${full_files[@]}" > "$last_file_path"
}

cache_diff() {
  local file="$1"
  local diff_tmp="$2"
  local ts id safe ansi_path html_path

  mkdir -p "$diff_cache_dir"
  ts="$(date +%Y-%m-%dT%H:%M:%S%z)"
  id="$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
  safe="$(basename -- "$file" | tr -cs 'A-Za-z0-9._-' '_')"
  ansi_path="$diff_cache_dir/${id}-${safe}.ansi"
  html_path="$diff_cache_dir/${id}-${safe}.html"

  cp -- "$diff_tmp" "$ansi_path"

  if command -v aha >/dev/null 2>&1; then
    aha --black < "$ansi_path" > "$html_path" 2>/dev/null || true
  fi

  printf '%s\t%s\t%s\t%s\n' "$ts" "$(abs_path "$file")" "$ansi_path" "$html_path" >> "$diff_index_path"
  prune_diff_cache
}

# Keep only the newest $diff_cache_keep diffs.
prune_diff_cache() {
  local total ansi html

  total="$(wc -l < "$diff_index_path")"
  [ "$total" -gt "$diff_cache_keep" ] || return 0

  head -n "$((total - diff_cache_keep))" "$diff_index_path" \
    | while IFS=$'\t' read -r _ _ ansi html; do
        rm -f -- ${ansi:+"$ansi"} ${html:+"$html"}
      done
  tail -n "$diff_cache_keep" "$diff_index_path" > "${diff_index_path}.tmp"
  mv -- "${diff_index_path}.tmp" "$diff_index_path"
}

output_cached_diffs() {
  local column=3 path

  if [ "${1:-}" = "html" ]; then
    column=4
  fi
  [ -f "$diff_index_path" ] || exit 0

  awk -F '\t' -v c="$column" '$c != "" {print $c}' "$diff_index_path" | while IFS= read -r path; do
    [ -f "$path" ] || continue
    cat -- "$path"
    printf '\n'
  done
  exit 0
}

# Print a colored diff of a file's contents before and after editing.
render_diff() {
  local label="$1"
  local before="$2"
  local after="$3"
  local diff_cmd=(diff -U5 --color=always --palette='ln=1;38;5;13'
    --label "$label" --label "$label" -- "$before" "$after")

  if command -v diff-so-fancy >/dev/null 2>&1; then
    # Drop diff-so-fancy's three-line file header; the hunk header names the file.
    { "${diff_cmd[@]}" || true; } | diff-so-fancy | sed '1,3d' || true
  else
    "${diff_cmd[@]}" || true
  fi
}

open_files() {
  local files=("$@")
  local i diff_tmp

  # Snapshot each file so we can show what changed once nvim exits.
  # Global (not local) so the EXIT trap can still see it.
  snapshot_dir="$(mktemp -d)"
  trap 'rm -rf -- "$snapshot_dir"' EXIT

  for i in "${!files[@]}"; do
    if [ -f "${files[$i]}" ]; then
      cp -- "${files[$i]}" "$snapshot_dir/$i"
    fi
  done

  if [ -n "$resume_line" ]; then
    nvim -c "autocmd VimEnter * ++once normal! ${resume_line}Gzz" -- "${files[@]}" || true
  else
    # silent!: g; fails with E664 on files that have no change history yet.
    nvim -c 'autocmd VimEnter * ++once silent! normal! g;zz' -- "${files[@]}" || true
  fi

  for i in "${!files[@]}"; do
    if [ -f "$snapshot_dir/$i" ] && [ -f "${files[$i]}" ] && ! cmp -s -- "$snapshot_dir/$i" "${files[$i]}"; then
      diff_tmp="$snapshot_dir/$i.diff"
      render_diff "${files[$i]}" "$snapshot_dir/$i" "${files[$i]}" | tee -- "$diff_tmp"
      cache_diff "${files[$i]}" "$diff_tmp"
    fi
  done
}

create_file() {
  local file="$1"
  local parent

  if [ -z "$file" ]; then
    printf 'v: file path cannot be empty\n' >&2
    exit 1
  fi

  if [ -d "$file" ]; then
    printf 'v: path is a directory: %s\n' "$file" >&2
    exit 1
  fi

  if [ -L "$file" ] && [ ! -e "$file" ]; then
    printf 'v: path is a broken symlink: %s\n' "$file" >&2
    exit 1
  fi

  if [ -e "$file" ] && [ ! -f "$file" ]; then
    printf 'v: path is not a regular file: %s\n' "$file" >&2
    exit 1
  fi

  parent="$(dirname -- "$file")"
  if [ ! -d "$parent" ]; then
    printf 'v: parent directory does not exist: %s\n' "$parent" >&2
    exit 1
  fi

  if [ ! -e "$file" ]; then
    touch -- "$file"
  fi

  remember_session "$file"
  open_files "$file"
}

# Fuzzy-pick from $files, preferring exact basename matches, then files with
# the query's extension. Extra arguments are passed through to fzf.
fuzzy_pick() {
  local query="$1"
  local candidates="$files"
  local matches
  shift

  matches="$(printf '%s\n' "$files" | name="$query" awk -F/ '$NF == ENVIRON["name"]')"
  if [ -z "$matches" ] && [[ "$query" == *.* ]]; then
    matches="$(printf '%s\n' "$files" | suffix=".${query##*.}" awk '
      { s = ENVIRON["suffix"] }
      substr($0, length($0) - length(s) + 1) == s')"
  fi
  if [ -n "$matches" ]; then
    candidates="$matches"
  fi

  printf '%s\n' "$candidates" | fzf "$@" --query="$query" --select-1 --exit-0
}

usage() {
  cat <<'EOF'
usage: v [FILE | QUERY]...

  v                 fuzzy-pick one or more files (git files, or fd outside git)
  v QUERY           open QUERY if it is a file, else fuzzy-match it
                    (exact file names win, then files with the same extension)
  v A B ...         open several files or queries at once
  v -               reopen the last session
  v -N | v - N      reopen the last session at line N
  v ~ [QUERY]       pick from files you opened before
  v -c [FILE]       create FILE (or the last unmatched QUERY) and open it
  v + | v diffs     print the cached diffs of your edits (add "html" for HTML)
  v -h | v --help   show this help

After nvim exits, v prints a diff of what you changed. The newest 200 diffs
are kept in ~/.local/state/v/diffs.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ "${1:-}" = "-c" ] || [ "${1:-}" = "--create" ]; then
  if [ "$#" -eq 1 ]; then
    if [ ! -s "$missing_file_path" ] || [ ! -s "$missing_directory_path" ]; then
      printf 'usage: v -c [FILE]\n' >&2
      exit 1
    fi
    if [ "$(pwd -P)" != "$(cat -- "$missing_directory_path")" ]; then
      printf 'v: missing file was requested in another directory; use v -c FILE\n' >&2
      exit 1
    fi
    missing_file="$(cat -- "$missing_file_path")"
    if [ -e "$missing_file" ] || [ -L "$missing_file" ]; then
      printf 'usage: v -c [FILE]\n' >&2
      exit 1
    fi
    create_file "$missing_file"
    rm -f -- "$missing_file_path" "$missing_directory_path"
  elif [ "$#" -eq 2 ]; then
    create_file "$2"
  else
    printf 'usage: v -c [FILE]\n' >&2
    exit 1
  fi
  exit 0
fi

if [ "${1:-}" = "+" ] || [ "${1:-}" = "diffs" ]; then
  output_cached_diffs "${2:-}"
fi

# Accept both v -42 and v - 42 when resuming at a specific line.
if [ "$#" -eq 1 ] && [[ "$1" =~ ^-[0-9]+$ ]]; then
  resume_line="${1#-}"
elif [ "$#" -eq 2 ] && [ "$1" = "-" ] && [[ "$2" =~ ^[0-9]+$ ]]; then
  resume_line="$2"
fi

if [ -n "$resume_line" ]; then
  resume_line="$((10#$resume_line))"
  if [ "$resume_line" -eq 0 ]; then
    printf 'v: line number must be positive\n' >&2
    exit 1
  fi
fi

if [ -n "$resume_line" ] || { [ "$#" -eq 1 ] && [ "${1:-}" = "-" ]; }; then
  if [ ! -f "$last_file_path" ]; then
    printf 'v: no previous file recorded\n' >&2
    exit 1
  fi
  mapfile -t previous_files < <(awk 'NF' "$last_file_path")
  if [ "${#previous_files[@]}" -eq 0 ]; then
    printf 'v: no previous file recorded\n' >&2
    exit 1
  fi
  for f in "${previous_files[@]}"; do
    if [ ! -e "$f" ]; then
      printf 'v: previous file is missing: %s\n' "$f" >&2
      exit 1
    fi
  done
  remember_session "${previous_files[@]}"
  open_files "${previous_files[@]}"
  exit 0
fi

if [ "${1:-}" = "~" ] || [ "${1:-}" = "$HOME" ]; then
  history_query="${*:2}"
  if [ ! -f "$history_file_path" ]; then
    printf 'v: no file history recorded\n' >&2
    exit 1
  fi
  f="$(
    while IFS= read -r entry; do
      if [ -n "$entry" ] && [ -e "$entry" ]; then
        printf '%s\n' "$entry"
      fi
    done < "$history_file_path" | fzf --query="$history_query" --select-1 --exit-0
  )" || exit 0
  [ -n "$f" ] || exit 0
  remember_session "$f"
  open_files "$f"
  exit 0
fi

# Everything else: each argument is an existing file or a fuzzy query.
need_file_list=false
if [ "$#" -eq 0 ]; then
  need_file_list=true
fi
for arg in "$@"; do
  [ -f "$arg" ] || need_file_list=true
done

files=""
if [ "$need_file_list" = true ]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    files="$(git ls-files --cached --others --exclude-standard)"
  elif command -v fd >/dev/null 2>&1; then
    files="$(fd --type f)"
  elif command -v fdfind >/dev/null 2>&1; then
    files="$(fdfind --type f)"
  else
    printf 'v: requires fd (or fdfind) outside a git repo\n' >&2
    exit 1
  fi
fi

selected_files=()
fuzzy_selected_files=()

if [ "$#" -eq 0 ]; then
  selection="$(printf '%s\n' "$files" | fzf --multi --select-1 --exit-0)" || exit 0
  [ -n "$selection" ] || exit 0
  mapfile -t selected_files <<< "$selection"
else
  # A single query may pick several files; with several queries, one each.
  fzf_opts=()
  if [ "$#" -eq 1 ]; then
    fzf_opts=(--multi)
  fi

  for arg in "$@"; do
    if [ -f "$arg" ]; then
      selected_files+=("$arg")
      continue
    fi

    rc=0
    selection="$(fuzzy_pick "$arg" "${fzf_opts[@]}")" || rc=$?
    if [ "$rc" -eq 1 ] || { [ "$rc" -eq 0 ] && [ -z "$selection" ]; }; then
      report_missing_file "$arg"
      exit 1
    elif [ "$rc" -ne 0 ]; then
      exit 0 # fzf was cancelled
    fi

    mapfile -t picked <<< "$selection"
    selected_files+=("${picked[@]}")
    fuzzy_selected_files+=("${picked[@]}")
  done
fi

for f in "${fuzzy_selected_files[@]}"; do
  print_fuzzy_resolution_if_new "$f"
done
remember_session "${selected_files[@]}"
open_files "${selected_files[@]}"
