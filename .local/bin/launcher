#!/bin/sh
# rofi in the theme that matches the wallpaper (~/.local/bin/wallpaper writes
# it to rofi.rasi in the state directory).
#   launcher ARGS...   run rofi with ARGS
#   launcher --args    print just the theme arguments, for tools that run rofi
#                      themselves (wifi, bluetooth)
theme="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/rofi.rasi"
[ -f "$theme" ] || theme="$HOME/.config/rofi/ben256.rasi"
if [ "${1:-}" = --args ]; then
    printf '%s\n' -monitor -4 -theme "$theme"
    exit 0
fi
exec rofi -monitor -4 -theme "$theme" "$@"
