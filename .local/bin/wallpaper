#!/bin/bash
set -eu
state="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/wallpaper"
choice=${1:-}
case "$choice" in
    --restore) choice=$(cat "$state" 2>/dev/null || printf default) ;;
    '') choice=$(printf 'Default\nNebula\n' | "$HOME/.local/bin/launcher" -dmenu -i -p Wallpaper) || exit 0 ;;
esac
case "$choice" in
    default|Default) choice=default; image="$HOME/Pictures/wallpaper.jpg" ;;
    nebula|Nebula) choice=nebula; image="$HOME/.local/share/wallpapers/nebula.jpg" ;;
    *) exit 2 ;;
esac
[ -f "$image" ] || exit 1
if [ "$choice" = nebula ]; then
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/wallpapers"
    mkdir -p "$cache"
    rotated="$cache/nebula-90.png"
    if [ ! -f "$rotated" ] || [ "$image" -nt "$rotated" ]; then
        temporary="$cache/nebula-90-$$.png"
        trap 'rm -f -- "$temporary"' EXIT HUP INT TERM
        convert "$image" -rotate 90 "$temporary"
        mv "$temporary" "$rotated"
        trap - EXIT HUP INT TERM
    fi
    feh --no-xinerama --bg-fill "$rotated"
    accent='#8FAEFF'
else
    feh --bg-scale "$image"
    accent='#00FF94'
fi
# Window borders are neutral on every wallpaper (see bspwmrc): faint white on
# the focused window, near-black on the rest.
bspc config normal_border_color '#1c1c1c'
bspc config active_border_color '#1c1c1c'
bspc config focused_border_color '#7a7a7a'
bspc config presel_feedback_color "$accent"
mkdir -p "$(dirname "$state")"
printf '%s\n' "$choice" > "$state.tmp-$$"
mv "$state.tmp-$$" "$state"
