#!/bin/sh
set -eu
state="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/wallpaper"
choice=${1:-}
case "$choice" in
    --restore) choice=$(cat "$state" 2>/dev/null || printf default) ;;
    '') choice=$(printf 'Default\nNebula\n' | "$HOME/.local/bin/launcher" -dmenu -i -p Wallpaper) || exit 0 ;;
esac
case "$choice" in
    default|Default) choice=default; image="$HOME/Pictures/wallpaper.jpg" ;;
    nebula|Nebula) choice=nebula; image="$HOME/.local/share/wallpapers/nebula.jpg" ;;
    *) exit 2 ;;
esac
[ -f "$image" ] || exit 1
if [ "$choice" = nebula ]; then
    dimensions=$(xdpyinfo | awk '/dimensions:/ { print $2; exit }')
    display -window root -rotate 90 -resize "${dimensions}^" -gravity center "$image" || [ "$?" -eq 1 ]
    normal='#252840'; active='#576799'; accent='#8FAEFF'
else
    feh --bg-scale "$image"
    normal='#1a3a1a'; active='#2d6b2d'; accent='#00FF94'
fi
bspc config normal_border_color "$normal"
bspc config active_border_color "$active"
bspc config focused_border_color "$accent"
bspc config presel_feedback_color "$accent"
mkdir -p "$(dirname "$state")"
printf '%s\n' "$choice" > "$state"
